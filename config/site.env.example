# Copy to a protected file outside the repository or to config/site.env locally.
# Never commit production secrets.

# Node role used by scripts for logging/safety.
NODE_ROLE=passive

# Expected hardware. The default intentionally only accepts Pi 3 family names.
EXPECTED_MODEL_REGEX='^Raspberry Pi 3'
EXPECTED_ARCH='aarch64|armv7l'

# Whole SD-card device. Never set this to a partition.
TARGET_DISK=/dev/mmcblk0

# Network values are informational until populated from the real site.
EXPECTED_INTERFACE=eth0
EXPECTED_IP=
EXPECTED_GATEWAY=
EXPECTED_MAC=

# Rescue settings.
RESCUE_SSH_PORT=2222
RESCUE_KERNEL=
RESCUE_INITRD=
RESCUE_DTB=
RESCUE_CMDLINE=

# Approved Debian artifact. Populate only after image testing.
DEBIAN_IMAGE=
DEBIAN_IMAGE_SHA512=

# Expected OS after migration.
EXPECTED_DEBIAN_VERSION=13
EXPECTED_DEBIAN_CODENAME=trixie

# FreeSWITCH acceptance settings.
EXPECTED_FREESWITCH_MAJOR_MINOR=1.11

# Optional path where inventory artifacts are written.
ARTIFACT_DIR=/var/tmp/pios-rebuild
