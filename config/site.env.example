# Copy to a protected file outside the repository or to config/site.env locally.
# Never commit production secrets.
#
# This generic example defaults to the original Pi 3 / CentOS 7 profile.
# For Raspberry Pi 4 / CentOS 9 use config/site-pi4-centos9.env.example.

NODE_ROLE=passive

# Fail-closed source identity gates.
EXPECTED_MODEL_REGEX='^Raspberry Pi 3'
EXPECTED_ARCH='aarch64|armv7l'
EXPECTED_SOURCE_OS_ID='centos'
EXPECTED_SOURCE_OS_VERSION='7'

# Whole SD-card device. Never set this to a partition and never assume the
# example value is correct without confirming it during preflight.
TARGET_DISK=/dev/mmcblk0

# Network values are informational/safety gates once populated.
EXPECTED_INTERFACE=eth0
EXPECTED_IP=
EXPECTED_GATEWAY=
EXPECTED_MAC=

# Rescue settings. The rescue build must have been proven on the selected
# Raspberry Pi / CentOS profile before destructive use.
RESCUE_SSH_PORT=2222
RESCUE_KERNEL=
RESCUE_INITRD=
RESCUE_DTB=
RESCUE_CMDLINE=

# Approved Debian artifact. Populate only after exact-image testing on the
# target hardware family.
DEBIAN_IMAGE=
DEBIAN_IMAGE_SHA512=

EXPECTED_DEBIAN_VERSION=13
EXPECTED_DEBIAN_CODENAME=trixie

# FreeSWITCH acceptance settings.
EXPECTED_FREESWITCH_MAJOR_MINOR=1.11

ARTIFACT_DIR=/var/tmp/pios-rebuild
