# Raspberry Pi 4 / CentOS 9 migration profile.
# Copy to protected storage outside the repository or to config/site.env locally.
# Never commit production secrets.

NODE_ROLE=passive

# Fail-closed source identity gates.
EXPECTED_MODEL_REGEX='^Raspberry Pi 4'
EXPECTED_ARCH='aarch64|arm64'
EXPECTED_SOURCE_OS_ID='centos'
EXPECTED_SOURCE_OS_VERSION='9'

# Whole SD-card device. Confirm this from preflight on the actual node.
# Never set this to a partition.
TARGET_DISK=/dev/mmcblk0

# Network values are informational/safety gates once populated.
EXPECTED_INTERFACE=eth0
EXPECTED_IP=
EXPECTED_GATEWAY=
EXPECTED_MAC=

# Rescue settings. These must reference the Pi 4 / CentOS 9 rescue build that
# has already passed the non-destructive round-trip test.
RESCUE_SSH_PORT=2222
RESCUE_KERNEL=
RESCUE_INITRD=
RESCUE_DTB=
RESCUE_CMDLINE=

# Approved Debian 13 artifact. Populate only after exact-image testing on Pi 4.
DEBIAN_IMAGE=
DEBIAN_IMAGE_SHA512=

EXPECTED_DEBIAN_VERSION=13
EXPECTED_DEBIAN_CODENAME=trixie

# FreeSWITCH acceptance settings.
EXPECTED_FREESWITCH_MAJOR_MINOR=1.11

ARTIFACT_DIR=/var/tmp/pios-rebuild
